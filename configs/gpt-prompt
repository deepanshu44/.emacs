;; https://github.com/nicferrier/elnode/blob/master/examples/elnode-ijs.el#L69

(defvar gpt-shell/input nil
  "Input for the js shell.

Each element is a cons of a uuid and the javascript to send.")

(defvar gpt-shell/input-hash (make-hash-table :test 'equal)
  "Record of things sent to the js engine.

This stores the UUID and the js comint process for all input.
The js engine uses the UUID to communicate results back to us,
when it does the relevant element is deleted.")

(defun gpt-shell-handler (httpcon)
  (gpt-defer-until (car-safe gpt-shell/input)
      (unwind-protect
           (gpt-send-json httpcon gpt-shell/input)
        (setq gpt-shell/input nil))))

(defun gpt-shell-result-handler (httpcon)
  (let* ((id (gpt-http-param httpcon "uuid"))
         (result (gpt-http-param httpcon "result"))
         (buffer (gethash id gpt-shell/input-hash)))
    (remhash id gpt-shell/input-hash)
    (if buffer
        (with-current-buffer buffer
          ;; Delete the hash
          (let ((buffer-read-only nil))
            (save-excursion
               (re-search-backward
                (concat "#" id)
                nil t)
               (delete-region (point) (line-end-position))
               (insert (format "%S" result)))))
        ;; Else
        (message "%s is not in the hash" id))))

(defconst gpt-shell-prompt "LLM> ")

(defun gpt-shell/input-sender (proc input)
  (let ((id (gpt-send-promt input))
        (buffer-read-only nil)
        (lb (- (line-beginning-position) 5)))
    (comint-output-filter proc (format "#%s\n" id))
    ;; (with-current-buffer
    ;; 	(current-buffer)
    ;;   (previous-line)
    ;;   (activate-mark)
    ;;   (comint-previous-prompt)
    ;;   (fill-region (region-beginning) (region-end))
    ;;   (comint-next-prompt)
    ;;   )
    (with-temp-buffer
      (comment-auto-fill)
      (newline)
      (insert  (concat "* " input))
      (insert id)
      (org-mode)
      (org-set-property "time" (format-time-string "%c"))
      (write-region nil nil "~/.emacs.d/gpt-prompt-history.org" t)
      )
    ;; (push (cons id input) gpt-shell/input)
    ;; (puthash id (process-buffer proc) gpt-shell/input-hash)
)
  (comint-output-filter proc gpt-shell-prompt))

(define-derived-mode
    gpt-shell/mode comint-mode "GPT_Mistral"
    "Run GPT shell"
    ;; :syntax-table js2-mode-syntax-table
    (setq comint-prompt-regexp (concat "^" (regexp-quote gpt-shell-prompt)))
    (setq comint-input-sender 'gpt-shell/input-sender)

    (unless (comint-check-proc (current-buffer))
      ;; Was cat, but on non-Unix platforms that might not exist, so
      ;; use hexl instead, which is part of the Emacs distribution.
      (let ((fake-proc
             (condition-case nil
                 (start-process "ijsm" (current-buffer) "hexl")
               (file-error (start-process "ijsm" (current-buffer) "cat")))))
        (set-process-query-on-exit-flag fake-proc nil)
        ;; Add a silly header
        (insert "Interactive GPT Mode\n")
        (set-marker
         (process-mark fake-proc) (point))
        (comint-output-filter fake-proc gpt-shell-prompt))))

;; This needs to take a url
(defun gpt-shell ()
  (interactive)
  (let ((name (format "Mistral:codestral-latest")))
    (let ((buf
           ;; This needs to be tied to the url
           (get-buffer-create (format "*%s*" name))))
      (with-current-buffer buf
        (gpt-shell/mode)
        (switch-to-buffer buf)))))

