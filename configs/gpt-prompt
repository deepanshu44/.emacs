;;; get history

;; idea for this function came from codestral-latest
(defun org-headlines-as-list ()
  "Return a list of all headlines in the current Org mode buffer."
  (let ((headlines '()))
    (org-map-entries
     (lambda ()
       (setq headlines  (append headlines (list (cons (org-get-heading) (point))))))
     )
    headlines
    ))

(defun gpt-shell/history ()
  (interactive)
  (insert (car (with-temp-buffer
    (progn
      (org-mode)
      (insert-file-contents "~/.emacs.d/gpt-prompt-history.org")
      (setq-local heading-list (org-headlines-as-list))
      (setq-local prompt-search (completing-read
				 "History element: "
				 heading-list))
      (search-forward prompt-search)
      (move-beginning-of-line nil)
      (org-map-entries (lambda () (concat (substring-no-properties (org-get-heading)) (replace-regexp-in-string "\\(\[\n\]\\|.\\)*END:\n" "" (buffer-substring-no-properties (point-min) (point-max))))) t 'tree)
      )
    )))
  (comint-interrupt-subjob)
  (gpt-shell)
  )

